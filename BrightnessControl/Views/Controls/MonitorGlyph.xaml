<UserControl x:Class="BrightnessControl.Views.Controls.MonitorGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="18" Height="16">
    <StackPanel HorizontalAlignment="Center">
        <Border Width="18" Height="12" CornerRadius="2" BorderThickness="1.5"
                BorderBrush="{StaticResource TextSecondaryBrush}"/>
        <Border Width="7" Height="2" Margin="0,1,0,0" Background="{StaticResource TextSecondaryBrush}"
                HorizontalAlignment="Center"/>
        <Border Width="11" Height="1.5" Margin="0,1,0,0" CornerRadius="1"
                Background="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
