<Window x:Class="BrightnessControl.Views.GameProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Profile" SizeToContent="Height" Width="380"
        Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20,18,20,18">
        <TextBlock Text="Profile name" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,16"/>

        <TextBlock Text="Executable" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ProcessNameBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
            <Button x:Name="PickProcessButton" Grid.Column="1" Content="Pick Game…" Click="PickProcessButton_Click"/>
        </Grid>

        <CheckBox x:Name="EnabledBox" Content="Enabled" IsChecked="True" Margin="0,0,0,18"/>

        <TextBlock Text="Brightness per monitor" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <StackPanel x:Name="SlidersPanel"/>
        </Border>

        <TextBlock x:Name="ValidationText" Foreground="{StaticResource DangerBrush}" FontSize="11.5" Margin="2,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Grid.Column="0" Content="Delete" Width="84"
                    Foreground="{StaticResource DangerBrush}" Click="DeleteButton_Click" Visibility="Collapsed"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancel" Width="84" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="Save" Width="84" IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
