<Window x:Class="BrightnessControl.Views.ProcessPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a running process" Height="420" Width="420"
        Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="FilterBox" Grid.Row="0" Margin="0,0,0,8"
                 TextChanged="FilterBox_TextChanged"
                 ToolTip="Filter by process name or window title"/>

        <ListView x:Name="ProcessList" Grid.Row="1" MouseDoubleClick="ProcessList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Process" Width="160" DisplayMemberBinding="{Binding ExeName}"/>
                    <GridViewColumn Header="Window Title" Width="200" DisplayMemberBinding="{Binding WindowTitle}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Select" Width="80" IsDefault="True" Click="SelectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
