<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>BrightnessControl</AssemblyName>
    <RootNamespace>BrightnessControl</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Brightness Control</Product>
    <AssemblyTitle>Brightness Control — IMZURA</AssemblyTitle>
    <Authors>zura</Authors>
    <Company>imzura.com</Company>
    <Version>1.2.2</Version>
    <FileVersion>1.2.2.0</FileVersion>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <Copyright>© 2026 zura — imzura.com</Copyright>
    <Description>Control external monitor brightness with per-game profiles. By zura (imzura.com).</Description>
  </PropertyGroup>

</Project>
